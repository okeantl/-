# Шаблон окружения SFMShop: скопируй в .env и подставь свои значения.
# Реальные значения в git не попадают: .env лежит в .gitignore.

# ===== Основная БД (src/core/config.py -> Settings) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sfmshop
DB_USER=postgres
DB_PASSWORD=your-db-password

# Реплика для чтения (src/database/connection.py)
DB_PRIMARY_HOST=localhost
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5432

# ===== Хранилище логов (src/services/log_service.py) =====
MONGO_HOST=localhost
MONGO_PORT=27017

# ===== Ограничения частоты запросов (src/api/limiter.py) =====
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PRODUCTS=30/minute

# ===== CORS (src/api/main.py) =====
CORS_ORIGINS=http://localhost:3000,https://sfmshop.example.ru

# ===== Основные настройки (src/core/config.py) =====
DATABASE_URL=postgresql://user:password@localhost:5432/sfmshop
SECRET_KEY=your-secret-key-here
REDIS_URL=redis://localhost:6379
DEBUG=False
MAX_CONNECTIONS=10

# ===== Внешние API =====
ANTHROPIC_API_KEY=your-anthropic-key
EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest

# ===== Опционально: YandexGPT =====
YANDEX_API_KEY=
YANDEX_FOLDER_ID=